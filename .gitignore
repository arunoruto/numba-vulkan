# --- Project ----------------------------------------------------------------

# Reference clones used while developing (numba, numba-cuda, taichi)
/refs/

# Generated shaders and ad-hoc benchmark dumps. Collected results under
# benchmarks/results/ are committed; the charts drawn from them are not.
*.spv
*.spvasm
/benchmarks/results.json
/docs/source/_generated/benchmarks/

# libclc bitcode, copied in by `bundle-libclc` for building distributions
/src/numba_vulkan/data/*.bc
/src/numba_vulkan/data/libclc-version.txt

# --- Python -----------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

